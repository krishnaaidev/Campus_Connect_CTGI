# CampusConnect Configuration
# Firebase Client SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Institutional Policies (Configurable Defaults)
VITE_COLLEGE_NAME="CT Group of Institutions"
VITE_CAMPUS_NAME="CTGI Campus"
VITE_TIMEZONE="Asia/Kolkata"
VITE_WORKING_HOURS_START="09:00"
VITE_WORKING_HOURS_END="16:30"
VITE_DAY_SCHOLAR_PASS_DEADLINE="14:00"
